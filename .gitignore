# Environment
.env
.env.*
*.env

# Credentials and secrets
credentials.json
*_credentials.*
*.pem
*.key

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp

# Sensitive outputs (never commit raw CRM data or contact lists)
outputs/lists/
outputs/raw/
*.csv

# Sync script live data outputs (contain metrics, not committed)
outputs/campaigns/**/results-sync.json
context/signal-performance-sync.json

# --- Multi-account additions ---

# Live MCP wiring: the send tool is never committed (the send wall — CLAUDE.md hard lines)
.mcp.json

# Per-account sensitive outputs: raw contact data never enters git
accounts/**/outputs/lists/
accounts/**/outputs/raw/
accounts/**/*.csv
accounts/**/_*.json
accounts/**/outputs/campaigns/**/results-sync.json
accounts/**/context/signal-performance-sync.json

# Python
__pycache__/
*.pyc

# Superseded material — retained in git history, not in the working tree
_archive/
